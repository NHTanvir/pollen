{
  "name": "@nhtanvir/pollen",
  "version": "0.1.0",
  "description": "poppy.json validator and generator for the Personal Agent Protocol (Poppy 1.0). Checks a live site end to end, scores it 0-100, and shows the fix for every failure. CLI, library, and GitHub Action.",
  "keywords": [
    "poppy",
    "poppy.json",
    "poppy-json",
    "personal-agent-protocol",
    "personal-agents",
    "ai-agents",
    "agent-readiness",
    "agentic-commerce",
    "well-known",
    "validator",
    "linter",
    "checker",
    "generator",
    "cli",
    "github-action",
    "oauth",
    "mcp",
    "ucp"
  ],
  "license": "MIT",
  "author": "NHTanvir",
  "homepage": "https://github.com/NHTanvir/pollen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NHTanvir/pollen.git"
  },
  "bugs": {
    "url": "https://github.com/NHTanvir/pollen/issues"
  },
  "type": "module",
  "bin": {
    "pollen": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "tests/fixtures",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "demo": "npm run build && node dist/src/cli.js demo"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "5.9.3"
  }
}
